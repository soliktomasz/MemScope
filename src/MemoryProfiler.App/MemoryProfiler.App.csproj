<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/memscope.ico</ApplicationIcon>

    <!-- Application Metadata -->
    <Product>MemScope</Product>
    <Description>Cross-platform managed memory profiler for .NET processes</Description>

    <!-- MinVer Configuration: derive version from git tags with a "v" prefix.
         Until the first tag exists the version stays 0.1.x-preview.* with build height. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerVerbosity>normal</MinVerVerbosity>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <MacOSAppBundlePath>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)/MemScope.app</MacOSAppBundlePath>
    <OutputPath>$(MacOSAppBundlePath)/Contents/MacOS/</OutputPath>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/memscope.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- MinVer for automatic versioning from git tags -->
    <PackageReference Include="MinVer" Version="7.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MemoryProfiler.Contracts/MemoryProfiler.Contracts.csproj" />
    <ProjectReference Include="../MemoryProfiler.Analysis/MemoryProfiler.Analysis.csproj" />
    <ProjectReference Include="../MemoryProfiler.Diagnostics/MemoryProfiler.Diagnostics.csproj" />
    <ProjectReference Include="../MemoryProfiler.Storage/MemoryProfiler.Storage.csproj" />
  </ItemGroup>
  <Target Name="PrepareMacOSAppBundle"
          AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <MakeDir Directories="$(MacOSAppBundlePath)/Contents/Resources" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Platforms/macOS/Info.plist"
          DestinationFolder="$(MacOSAppBundlePath)/Contents"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Assets/memscope.icns"
          DestinationFolder="$(MacOSAppBundlePath)/Contents/Resources"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CleanMacOSAppBundle"
          AfterTargets="Clean"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <RemoveDir Directories="$(MacOSAppBundlePath)" />
  </Target>
</Project>
