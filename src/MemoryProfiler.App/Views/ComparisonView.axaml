<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MemoryProfiler.App.ViewModels"
             xmlns:cmp="using:MemoryProfiler.App.ViewModels.Comparison"
             x:Class="MemoryProfiler.App.Views.ComparisonView"
             x:DataType="vm:ComparisonViewModel"
             x:CompileBindings="True">
  <UserControl.Styles>
    <Style Selector="TextBlock.dashboard-title">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.section-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.mono-data">
      <Setter Property="FontFamily" Value="Cascadia Mono, Menlo, Consolas" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.table-header">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.dashboard-action">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="15,7" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.table-header">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.picker-card">
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}" />
    </Style>
    <Style Selector="ListBox.delta-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.delta-list ListBoxItem">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="32,26,32,28"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="16">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <StackPanel Spacing="4">
        <TextBlock Classes="dashboard-title" Text="Compare Snapshots" />
        <TextBlock Classes="secondary"
                   FontSize="13"
                   Text="Pick a before and after snapshot to see per-type memory changes." />
      </StackPanel>
      <Button Grid.Column="1"
              Classes="dashboard-action"
              VerticalAlignment="Top"
              Command="{Binding CloseCommand}"
              Content="Close" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="14">
      <Border Classes="picker-card">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="5">
            <TextBlock Classes="section-label" Text="BEFORE" />
            <TextBlock Classes="mono-data"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding BeforePath}"
                       IsVisible="{Binding HasBefore}"
                       Text="{Binding BeforePath}" />
            <TextBlock Classes="secondary"
                       FontSize="13"
                       IsVisible="{Binding HasBefore, Converter={x:Static BoolConverters.Not}}"
                       Text="No snapshot chosen" />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="dashboard-action"
                  VerticalAlignment="Center"
                  Command="{Binding PickBeforeCommand}"
                  Content="Choose…" />
        </Grid>
      </Border>
      <TextBlock Grid.Column="1"
                 Classes="section-label"
                 VerticalAlignment="Center"
                 Text="→" />
      <Border Grid.Column="2" Classes="picker-card">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="5">
            <TextBlock Classes="section-label" Text="AFTER" />
            <TextBlock Classes="mono-data"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding AfterPath}"
                       IsVisible="{Binding HasAfter}"
                       Text="{Binding AfterPath}" />
            <TextBlock Classes="secondary"
                       FontSize="13"
                       IsVisible="{Binding HasAfter, Converter={x:Static BoolConverters.Not}}"
                       Text="No snapshot chosen" />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="dashboard-action"
                  VerticalAlignment="Center"
                  Command="{Binding PickAfterCommand}"
                  Content="Choose…" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2"
          RowDefinitions="Auto,Auto"
          RowSpacing="8">
      <StackPanel Grid.Row="0"
                  IsVisible="{Binding ShowProgress}"
                  Spacing="4"
                  AutomationProperties.Name="{Binding StatusText}"
                  AutomationProperties.LiveSetting="Polite">
        <ProgressBar Height="2"
                     AutomationProperties.Name="Comparison progress"
                     Value="{Binding Progress}" />
        <TextBlock Classes="secondary"
                   FontSize="12"
                   Text="{Binding StatusText}" />
      </StackPanel>

      <Border Grid.Row="1"
              IsVisible="{Binding ShowError}"
              Padding="12,9"
              CornerRadius="{DynamicResource AppCornerRadius}"
              AutomationProperties.Name="{Binding ErrorMessage}"
              AutomationProperties.LiveSetting="Assertive"
              Background="{DynamicResource AppErrorSurfaceBrush}">
        <TextBlock Foreground="{DynamicResource AppErrorTextBrush}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Text="{Binding ErrorMessage}" />
      </Border>

      <Grid Grid.Row="1"
            IsVisible="{Binding HasCompared}"
            ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
            ColumnSpacing="18">
        <CheckBox Content="Growing only"
                  AutomationProperties.Name="Growing only filter"
                  IsChecked="{Binding Table.ShowGrowingOnly, Mode=TwoWay}" />
        <CheckBox Grid.Column="1"
                  Content="New types"
                  AutomationProperties.Name="New types filter"
                  IsChecked="{Binding Table.ShowNewTypes, Mode=TwoWay}" />
        <CheckBox Grid.Column="2"
                  Content="Disappeared types"
                  AutomationProperties.Name="Disappeared types filter"
                  IsChecked="{Binding Table.ShowDisappearedTypes, Mode=TwoWay}" />
        <StackPanel Grid.Column="3" Spacing="5">
          <TextBlock Classes="section-label" Text="MIN Δ" />
          <TextBox Width="110"
                   AutomationProperties.Name="Minimum delta filter"
                   PlaceholderText="e.g. 100 KB"
                   Text="{Binding Table.MinimumDeltaText}" />
        </StackPanel>
        <StackPanel Grid.Column="5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,2,8"
                    Spacing="4">
          <TextBlock Classes="secondary"
                     HorizontalAlignment="Right"
                     FontSize="12"
                     Text="{Binding Table.ShownSummary}" />
          <TextBlock Classes="secondary"
                     HorizontalAlignment="Right"
                     FontSize="12"
                     IsVisible="{Binding HasRetainedSizeNote}"
                     Text="{Binding RetainedSizeNote}" />
        </StackPanel>
      </Grid>
    </Grid>

    <Grid Grid.Row="3" RowDefinitions="Auto,*">
      <Grid Grid.Row="0"
            IsVisible="{Binding ShowTable}"
            ColumnDefinitions="*,120,110,110"
            ColumnSpacing="8"
            Background="{DynamicResource AppSurfaceSubtleBrush}">
        <Button Grid.Column="0"
                Classes="table-header"
                Command="{Binding Table.SortByTypeNameCommand}"
                ToolTip.Tip="{Binding Table.TypeNameSortDescription}"
                Content="{Binding Table.TypeNameHeader}" />
        <Button Grid.Column="1"
                Classes="table-header"
                HorizontalContentAlignment="Right"
                Command="{Binding Table.SortByCountDeltaCommand}"
                ToolTip.Tip="{Binding Table.CountDeltaSortDescription}"
                Content="{Binding Table.CountDeltaHeader}" />
        <Button Grid.Column="2"
                Classes="table-header"
                HorizontalContentAlignment="Right"
                Command="{Binding Table.SortBySizeDeltaCommand}"
                ToolTip.Tip="{Binding Table.SizeDeltaSortDescription}"
                Content="{Binding Table.SizeDeltaHeader}" />
        <Button Grid.Column="3"
                Classes="table-header"
                HorizontalContentAlignment="Right"
                Command="{Binding Table.SortByRetainedDeltaCommand}"
                ToolTip.Tip="{Binding Table.RetainedDeltaSortDescription}"
                Content="{Binding Table.RetainedDeltaHeader}" />
      </Grid>

      <ListBox Grid.Row="1"
               Classes="delta-list"
               AutomationProperties.Name="Type memory changes"
               IsVisible="{Binding ShowTable}"
               ItemsSource="{Binding Table.FilteredDeltas}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="cmp:TypeDeltaRowViewModel">
            <Grid ColumnDefinitions="*,120,110,110"
                  MinHeight="30">
              <TextBlock Grid.Column="0"
                         Margin="10,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding TypeName}"
                         Text="{Binding TypeName}" />
              <TextBlock Grid.Column="1"
                         Margin="10,0"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Right"
                         Classes="mono-data"
                         Text="{Binding CountDeltaDisplay}" />
              <TextBlock Grid.Column="2"
                         Margin="10,0"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Right"
                         Classes="mono-data"
                         Text="{Binding SizeDeltaDisplay}" />
              <TextBlock Grid.Column="3"
                         Margin="10,0"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Right"
                         IsVisible="{Binding IsRetainedDeltaAvailable}"
                         Classes="mono-data"
                         Text="{Binding RetainedDeltaDisplay}" />
              <TextBlock Grid.Column="3"
                         Margin="10,0"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Right"
                         IsVisible="{Binding IsRetainedDeltaUnavailable}"
                         Classes="secondary"
                         Text="N/A" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel IsVisible="{Binding ShowChoosePrompt}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Choose snapshots to compare"
                  AutomationProperties.LiveSetting="Polite"
                  Spacing="6">
        <TextBlock HorizontalAlignment="Center"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                   Text="Choose a before and after snapshot" />
        <TextBlock Classes="secondary"
                   HorizontalAlignment="Center"
                   FontSize="13"
                   Text="Pick a dump captured before the change and one captured after." />
      </StackPanel>

      <StackPanel IsVisible="{Binding ShowNoChanges}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="No type changes found"
                  AutomationProperties.LiveSetting="Polite"
                  Spacing="6">
        <TextBlock HorizontalAlignment="Center"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                   Text="No type changes found" />
        <TextBlock Classes="secondary"
                   HorizontalAlignment="Center"
                   FontSize="13"
                   Text="The two snapshots have identical type memory." />
      </StackPanel>

      <StackPanel IsVisible="{Binding ShowNoFilteredDeltas}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="No types match the filters"
                  AutomationProperties.LiveSetting="Polite"
                  Spacing="6">
        <TextBlock HorizontalAlignment="Center"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                   Text="No types match the filters" />
        <TextBlock Classes="secondary"
                   HorizontalAlignment="Center"
                   FontSize="13"
                   Text="Adjust or clear the filters above." />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
