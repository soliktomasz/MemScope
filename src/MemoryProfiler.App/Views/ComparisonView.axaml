<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MemoryProfiler.App.ViewModels"
             xmlns:cmp="using:MemoryProfiler.App.ViewModels.Comparison"
             xmlns:views="using:MemoryProfiler.App.Views"
             x:Class="MemoryProfiler.App.Views.ComparisonView"
             x:DataType="vm:ComparisonViewModel"
             x:CompileBindings="True">
  <UserControl.Styles>
    <Style Selector="Border.picker-card">
      <Setter Property="Padding" Value="18,14" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="{DynamicResource AppPageMargin}"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="16">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <StackPanel Spacing="4">
        <TextBlock Classes="view-title" Text="Compare Snapshots" />
        <TextBlock Classes="secondary"
                   FontSize="13"
                   Text="Pick a before and after snapshot to see per-type memory changes." />
      </StackPanel>
      <Button Grid.Column="1"
              Classes="app-button subtle"
              VerticalAlignment="Top"
              Command="{Binding CloseCommand}"
              Content="Close" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="14">
      <Border Classes="surface picker-card">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="5">
            <TextBlock Classes="section-label" Text="Before" />
            <TextBlock Classes="mono-data"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding BeforePath}"
                       IsVisible="{Binding HasBefore}"
                       Text="{Binding BeforePath}" />
            <TextBlock Classes="secondary"
                       FontSize="13"
                       IsVisible="{Binding HasBefore, Converter={x:Static BoolConverters.Not}}"
                       Text="No snapshot chosen" />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="app-button"
                  VerticalAlignment="Center"
                  Command="{Binding PickBeforeCommand}"
                  Content="Choose…" />
        </Grid>
      </Border>
      <TextBlock Grid.Column="1"
                 Classes="section-label"
                 VerticalAlignment="Center"
                 Text="→" />
      <Border Grid.Column="2" Classes="surface picker-card">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="5">
            <TextBlock Classes="section-label" Text="After" />
            <TextBlock Classes="mono-data"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding AfterPath}"
                       IsVisible="{Binding HasAfter}"
                       Text="{Binding AfterPath}" />
            <TextBlock Classes="secondary"
                       FontSize="13"
                       IsVisible="{Binding HasAfter, Converter={x:Static BoolConverters.Not}}"
                       Text="No snapshot chosen" />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="app-button"
                  VerticalAlignment="Center"
                  Command="{Binding PickAfterCommand}"
                  Content="Choose…" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Classes="subtle-surface"
            Padding="14,10">
      <Grid RowDefinitions="Auto,Auto"
            RowSpacing="8">
      <StackPanel Grid.Row="0"
                  IsVisible="{Binding ShowProgress}"
                  Spacing="4"
                  AutomationProperties.Name="{Binding StatusText}"
                  AutomationProperties.LiveSetting="Polite">
        <ProgressBar Height="2"
                     AutomationProperties.Name="Comparison progress"
                     Maximum="1"
                     Value="{Binding Progress}" />
        <TextBlock Classes="secondary"
                   FontSize="12"
                   Text="{Binding StatusText}" />
        <Button Classes="app-button"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Cancel snapshot comparison"
                Command="{Binding CancelCommand}"
                Content="Cancel" />
      </StackPanel>

      <Grid Grid.Row="1" IsVisible="{Binding ShowError}">
        <views:ErrorDetailsView DataContext="{Binding Error}" />
      </Grid>

      <Grid Grid.Row="1"
            IsVisible="{Binding HasCompared}"
            ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
            ColumnSpacing="18">
        <CheckBox Content="Growing only"
                  AutomationProperties.Name="Growing only filter"
                  IsChecked="{Binding Table.ShowGrowingOnly, Mode=TwoWay}" />
        <CheckBox Grid.Column="1"
                  Content="New types"
                  AutomationProperties.Name="New types filter"
                  IsChecked="{Binding Table.ShowNewTypes, Mode=TwoWay}" />
        <CheckBox Grid.Column="2"
                  Content="Disappeared types"
                  AutomationProperties.Name="Disappeared types filter"
                  IsChecked="{Binding Table.ShowDisappearedTypes, Mode=TwoWay}" />
        <StackPanel Grid.Column="3" Spacing="5">
          <TextBlock Classes="section-label" Text="Minimum delta" />
          <TextBox Width="110"
                   AutomationProperties.Name="Minimum delta filter"
                   PlaceholderText="e.g. 100 KB"
                   Text="{Binding Table.MinimumDeltaText}" />
        </StackPanel>
        <StackPanel Grid.Column="5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,2,8"
                    Spacing="4">
          <TextBlock Classes="secondary"
                     HorizontalAlignment="Right"
                     FontSize="12"
                     Text="{Binding Table.ShownSummary}" />
          <TextBlock Classes="secondary"
                     HorizontalAlignment="Right"
                     FontSize="12"
                     IsVisible="{Binding HasRetainedSizeNote}"
                     Text="{Binding RetainedSizeNote}" />
        </StackPanel>
      </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="3">
      <DataGrid AutomationProperties.Name="Type memory changes"
                IsVisible="{Binding ShowTable}"
                AutoGenerateColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                IsReadOnly="True"
                GridLinesVisibility="Horizontal"
                ItemsSource="{Binding Table.FilteredDeltas}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Type"
                              Width="*"
                              SortMemberPath="TypeName"
                              Binding="{Binding TypeName}" />
          <DataGridTextColumn Header="Count delta"
                              Width="120"
                              SortMemberPath="CountDelta"
                              Binding="{Binding CountDeltaDisplay}" />
          <DataGridTextColumn Header="Size delta"
                              Width="110"
                              SortMemberPath="SizeDelta"
                              Binding="{Binding SizeDeltaDisplay}" />
          <DataGridTextColumn Header="Retained delta"
                              Width="110"
                              SortMemberPath="RetainedDelta"
                              Binding="{Binding RetainedDeltaDisplay}" />
        </DataGrid.Columns>
      </DataGrid>

      <Border IsVisible="{Binding ShowChoosePrompt}"
              Classes="empty-state"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              AutomationProperties.Name="Choose snapshots to compare"
              AutomationProperties.LiveSetting="Polite">
        <StackPanel Spacing="6">
          <TextBlock HorizontalAlignment="Center"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                     Text="Choose a before and after snapshot" />
          <TextBlock Classes="secondary"
                     HorizontalAlignment="Center"
                     Text="Pick a dump captured before the change and one captured after." />
        </StackPanel>
      </Border>

      <Border IsVisible="{Binding ShowNoChanges}"
              Classes="empty-state"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              AutomationProperties.Name="No type changes found"
              AutomationProperties.LiveSetting="Polite">
        <StackPanel Spacing="6">
          <TextBlock HorizontalAlignment="Center"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                     Text="No type changes found" />
          <TextBlock Classes="secondary"
                     HorizontalAlignment="Center"
                     Text="The two snapshots have identical type memory." />
        </StackPanel>
      </Border>

      <Border IsVisible="{Binding ShowNoFilteredDeltas}"
              Classes="empty-state"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              AutomationProperties.Name="No types match the filters"
              AutomationProperties.LiveSetting="Polite">
        <StackPanel Spacing="6">
          <TextBlock HorizontalAlignment="Center"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                     Text="No types match the filters" />
          <TextBlock Classes="secondary"
                     HorizontalAlignment="Center"
                     Text="Adjust or clear the filters above." />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
