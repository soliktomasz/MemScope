<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MemoryProfiler.App.ViewModels"
             xmlns:gc="using:MemoryProfiler.App.ViewModels.GcTimeline"
             xmlns:views="using:MemoryProfiler.App.Views"
             x:Class="MemoryProfiler.App.Views.LiveSessionView"
             x:DataType="vm:LiveSessionViewModel"
             x:CompileBindings="True">
  <UserControl.Styles>
    <Style Selector="ListBox.gc-events">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.gc-events ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppControlCornerRadius}" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="{DynamicResource AppPageMargin}"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="18">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <StackPanel Spacing="4">
        <TextBlock Classes="view-title" Text="Live diagnostics" />
        <TextBlock Classes="secondary"
                   FontSize="13"
                   Text="{Binding ProcessDescription}" />
      </StackPanel>
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Spacing="14">
        <TextBlock IsVisible="{Binding IsConnecting}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   Text="Connecting" />
        <TextBlock IsVisible="{Binding IsLive}"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppAccentBrush}"
                   Text="Live" />
        <TextBlock IsVisible="{Binding IsDisconnected}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   Text="Disconnected" />
        <Button Classes="app-button primary"
                Command="{Binding CaptureSnapshotCommand}"
                Content="Capture Snapshot" />
        <Button Classes="app-button"
                IsVisible="{Binding IsCapturing}"
                Command="{Binding CancelCaptureCommand}"
                Content="Cancel capture" />
        <Button Classes="app-button"
                Command="{Binding DisconnectCommand}"
                Content="Disconnect" />
        <Button Classes="app-button"
                IsVisible="{Binding IsDisconnected}"
                Command="{Binding CloseCommand}"
                Content="Choose another process" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="8">
      <ProgressBar Height="2"
                   AutomationProperties.Name="Connecting to target process"
                   AutomationProperties.LiveSetting="Polite"
                   IsVisible="{Binding IsConnecting}"
                   IsIndeterminate="True" />
      <ProgressBar Height="2"
                   AutomationProperties.Name="Capturing managed process snapshot"
                   AutomationProperties.LiveSetting="Polite"
                   IsVisible="{Binding IsCapturing}"
                   IsIndeterminate="True" />
      <Grid IsVisible="{Binding HasCaptureStatus}"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="10"
            AutomationProperties.Name="{Binding CaptureStatusMessage}"
            AutomationProperties.LiveSetting="Polite">
        <TextBlock Grid.Column="0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                   Text="{Binding CaptureStatusMessage}" />
        <TextBlock Grid.Column="1"
                   FontSize="13"
                   Classes="secondary"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding CapturedDumpPath}"
                   Text="{Binding CapturedDumpPath}" />
        <Button Grid.Column="2"
                Classes="app-button subtle"
                MinHeight="28"
                Padding="12,4"
                IsVisible="{Binding CanAnalyzeSnapshot}"
                Command="{Binding AnalyzeSnapshotCommand}"
                Content="Analyze" />
      </Grid>
      <Grid IsVisible="{Binding HasError}">
        <views:ErrorDetailsView DataContext="{Binding Error}" />
      </Grid>
      <Grid IsVisible="{Binding HasCaptureError}">
        <views:ErrorDetailsView DataContext="{Binding CaptureError}" />
      </Grid>
    </StackPanel>

    <TabControl Grid.Row="2">
      <TabItem Header="Overview">
        <Grid>
          <TextBlock IsVisible="{Binding IsAwaitingMetrics}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Classes="secondary"
                     Text="Waiting for the first runtime sample." />
          <ScrollViewer IsVisible="{Binding HasMetrics}"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,18,0,0" Spacing="20">
        <Border Classes="subtle-surface" Padding="20,16">
          <Grid ColumnDefinitions="3*,2*"
                ColumnSpacing="30">
            <StackPanel Spacing="7">
              <TextBlock Classes="section-label" Text="Managed heap" />
              <TextBlock Classes="metric-primary"
                         AutomationProperties.Name="Managed heap size"
                         Text="{Binding Heap.ManagedHeapSizeDisplay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="7">
              <TextBlock Classes="section-label" Text="Allocation rate" />
              <TextBlock Classes="metric-primary"
                         AutomationProperties.Name="Allocation rate"
                         Text="{Binding Allocation.AllocationRateDisplay}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0">
          <Grid Margin="0,18,0,0"
                RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnDefinitions="2*,*,*"
                RowSpacing="0">
            <TextBlock Grid.Row="0" Classes="section-label" Text="Generation" />
            <TextBlock Grid.Row="0" Grid.Column="1" Classes="section-label" Text="Size" />
            <TextBlock Grid.Row="0" Grid.Column="2" Classes="section-label" Text="Collections" />

            <TextBlock Grid.Row="1" Margin="0,13" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="Gen 0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,13" Classes="metric-value" Text="{Binding Generations.Generation0SizeDisplay}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,13" Classes="metric-value" Text="{Binding Generations.Generation0Collections}" />

            <TextBlock Grid.Row="2" Margin="0,13" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="Gen 1" />
            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,13" Classes="metric-value" Text="{Binding Generations.Generation1SizeDisplay}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,13" Classes="metric-value" Text="{Binding Generations.Generation1Collections}" />

            <TextBlock Grid.Row="3" Margin="0,13" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="Gen 2" />
            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,13" Classes="metric-value" Text="{Binding Generations.Generation2SizeDisplay}" />
            <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,13" Classes="metric-value" Text="{Binding Generations.Generation2Collections}" />
          </Grid>
        </Border>

        <Border BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0">
          <Grid Margin="0,18,0,0"
                ColumnDefinitions="*,*,*"
                ColumnSpacing="26">
            <StackPanel Spacing="7">
              <TextBlock Classes="section-label" Text="Large object heap" />
              <TextBlock Classes="metric-value" Text="{Binding Heap.LargeObjectHeapSizeDisplay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="7">
              <TextBlock Classes="section-label" Text="Pinned object heap" />
              <TextBlock Classes="metric-value" Text="{Binding Heap.PinnedObjectHeapSizeDisplay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="7">
              <TextBlock Classes="section-label" Text="Promoted bytes" />
              <TextBlock Classes="metric-value" Text="{Binding Heap.PromotedBytesDisplay}" />
            </StackPanel>
          </Grid>
        </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="GC timeline">
        <Grid Margin="0,18,0,0"
              RowDefinitions="3*,2*"
              RowSpacing="18">
          <Grid Grid.Row="0" RowDefinitions="Auto,Auto,*" RowSpacing="12">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
              <StackPanel Spacing="5">
                <TextBlock Classes="section-label" Text="Generation" />
                <ComboBox Width="150"
                          IsEnabled="{Binding GcTimeline.HasEvents}"
                          AutomationProperties.Name="Generation filter"
                          ItemsSource="{Binding GcTimeline.GenerationFilters}"
                          SelectedItem="{Binding GcTimeline.SelectedGenerationFilter}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Classes="section-label" Text="Minimum pause" />
                <Grid ColumnDefinitions="110,Auto" ColumnSpacing="7">
                  <TextBox Grid.Column="0"
                           IsEnabled="{Binding GcTimeline.HasEvents}"
                           AutomationProperties.Name="Minimum pause duration in milliseconds"
                           Text="{Binding GcTimeline.MinimumPauseMilliseconds}" />
                  <TextBlock Grid.Column="1"
                             VerticalAlignment="Center"
                             Classes="secondary"
                             Text="ms" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="2"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="0,0,2,8"
                          Orientation="Horizontal"
                          Spacing="14">
                <TextBlock Classes="secondary"
                           Text="{Binding GcTimeline.FilteredEventCount, StringFormat='{}{0} shown'}" />
                <TextBlock Classes="secondary"
                           Text="{Binding GcTimeline.Generation2EventCount, StringFormat='{}{0} Gen 2'}" />
                <TextBlock Classes="secondary"
                           Text="{Binding GcTimeline.IneffectiveEventCount, StringFormat='{}{0} low reclaim'}" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
              <Border IsVisible="{Binding GcTimeline.HasNoEvents}"
                      Classes="empty-state">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6">
                  <TextBlock HorizontalAlignment="Center"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                             Text="No GC events yet" />
                  <TextBlock HorizontalAlignment="Center"
                             Classes="secondary"
                             Text="Events appear here as the runtime completes collections." />
                </StackPanel>
              </Border>

              <Border IsVisible="{Binding GcTimeline.HasNoFilteredEvents}"
                      Classes="empty-state">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6">
                  <TextBlock HorizontalAlignment="Center"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                             Text="No events match these filters" />
                  <TextBlock HorizontalAlignment="Center"
                             Classes="secondary"
                             Text="Lower the pause threshold or choose another generation." />
                </StackPanel>
              </Border>

              <DataGrid IsVisible="{Binding GcTimeline.HasFilteredEvents}"
                        AutomationProperties.Name="Garbage collection events"
                        AutoGenerateColumns="False"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="True"
                        IsReadOnly="True"
                        GridLinesVisibility="Horizontal"
                        ItemsSource="{Binding GcTimeline.FilteredEvents}"
                        SelectedItem="{Binding GcTimeline.SelectedEvent}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Time" Width="100" SortMemberPath="Timestamp" Binding="{Binding TimeDisplay}" />
                  <DataGridTextColumn Header="Gen" Width="65" SortMemberPath="Generation" Binding="{Binding GenerationDisplay}" />
                  <DataGridTextColumn Header="Pause" Width="80" SortMemberPath="PauseMilliseconds" Binding="{Binding PauseDisplay}" />
                  <DataGridTextColumn Header="Heap before" Width="105" SortMemberPath="HeapSizeBefore" Binding="{Binding HeapBeforeDisplay}" />
                  <DataGridTextColumn Header="Heap after" Width="105" SortMemberPath="HeapSizeAfter" Binding="{Binding HeapAfterDisplay}" />
                  <DataGridTextColumn Header="Reclaimed" Width="95" SortMemberPath="ReclaimedBytes" Binding="{Binding EffectivenessDisplay}" />
                  <DataGridTextColumn Header="Reason" Width="*" SortMemberPath="Reason" Binding="{Binding Reason}" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Grid>

          <Border Grid.Row="1"
                  Classes="subtle-surface"
                  Padding="18">
            <Grid>
              <StackPanel IsVisible="{Binding GcTimeline.HasNoSelection}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="6">
                <TextBlock HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           Text="Select a collection" />
                <TextBlock HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Classes="secondary"
                           Text="Inspect pause duration, collection reason, and heap effectiveness." />
              </StackPanel>

              <Grid IsVisible="{Binding GcTimeline.HasSelection}"
                    ColumnDefinitions="2*,2*,3*"
                    ColumnSpacing="30">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Classes="section-label" Text="Selected collection" />
                  <TextBlock FontSize="20"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                             Text="{Binding GcTimeline.SelectedEvent.GenerationDisplay}" />
                  <TextBlock Classes="secondary"
                             Text="{Binding GcTimeline.SelectedEvent.TimeDisplay}" />
                  <TextBlock Margin="0,8,0,0"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                             TextWrapping="Wrap"
                             Text="{Binding GcTimeline.SelectedEvent.Reason}" />
                </StackPanel>

                <Grid Grid.Column="1"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="20">
                  <StackPanel Spacing="5">
                    <TextBlock Classes="section-label" Text="Pause" />
                    <TextBlock Classes="metric-value"
                               Text="{Binding GcTimeline.SelectedEvent.PauseDisplay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Classes="section-label" Text="Reclaimed" />
                    <TextBlock Classes="metric-value"
                               Text="{Binding GcTimeline.SelectedEvent.ReclaimedDisplay}" />
                  </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" Spacing="10">
                  <TextBlock Classes="section-label" Text="Heap change" />
                  <Grid ColumnDefinitions="64,*" RowDefinitions="Auto,Auto" RowSpacing="9" ColumnSpacing="10">
                    <TextBlock Grid.Row="0" Classes="secondary" Text="Before" />
                    <ProgressBar Grid.Row="0" Grid.Column="1"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="{Binding GcTimeline.SelectedEvent.HeapBeforeRatio}" />
                    <TextBlock Grid.Row="1" Classes="secondary" Text="After" />
                    <ProgressBar Grid.Row="1" Grid.Column="1"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="{Binding GcTimeline.SelectedEvent.HeapAfterRatio}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,*">
                    <TextBlock Classes="mono-data"
                               Text="{Binding GcTimeline.SelectedEvent.HeapBeforeDisplay}" />
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               Classes="mono-data"
                               Text="{Binding GcTimeline.SelectedEvent.HeapAfterDisplay}" />
                  </Grid>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
