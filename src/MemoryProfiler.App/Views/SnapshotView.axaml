<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MemoryProfiler.App.ViewModels"
             xmlns:types="using:MemoryProfiler.App.ViewModels.Types"
             xmlns:objects="using:MemoryProfiler.App.ViewModels.Objects"
             xmlns:views="using:MemoryProfiler.App.Views"
             x:Class="MemoryProfiler.App.Views.SnapshotView"
             x:DataType="vm:SnapshotViewModel"
             x:CompileBindings="True">
  <UserControl.Styles>
    <Style Selector="TextBlock.dashboard-title">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.section-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.metric-value">
      <Setter Property="FontFamily" Value="Cascadia Mono, Menlo, Consolas" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.mono-data">
      <Setter Property="FontFamily" Value="Cascadia Mono, Menlo, Consolas" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.table-header">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.dashboard-action">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="15,7" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.navigation-button">
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.table-header">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.skeleton">
      <Setter Property="Height" Value="12" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}" />
    </Style>
    <Style Selector="ListBox.type-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.type-list ListBoxItem">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
    </Style>
    <Style Selector="ListBox.instance-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.instance-list ListBoxItem">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
    </Style>
    <Style Selector="ListBox.reference-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.reference-list ListBoxItem">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
    </Style>
    <Style Selector="ListBox.path-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.path-list ListBoxItem">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
    </Style>
    <Style Selector="Button.direction-button">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="12,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
    </Style>
    <Style Selector="Button.direction-button.active">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="32,26,32,28"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="16">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Spacing="4">
          <Button Classes="navigation-button"
                  AutomationProperties.Name="Go back"
                  ToolTip.Tip="Back"
                  Command="{Binding GoBackCommand}"
                  Content="←" />
          <Button Classes="navigation-button"
                  AutomationProperties.Name="Go forward"
                  ToolTip.Tip="Forward"
                  Command="{Binding GoForwardCommand}"
                  Content="→" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="dashboard-title" Text="Snapshot" />
          <TextBlock Classes="secondary"
                     FontSize="13"
                     Text="{Binding ProcessDescription}" />
        </StackPanel>
      </StackPanel>
      <Button Grid.Column="1"
              Classes="dashboard-action"
              VerticalAlignment="Top"
              Command="{Binding CloseCommand}"
              Content="Close" />
    </Grid>

    <Grid Grid.Row="1"
          IsVisible="{Binding IsReady}"
          ColumnDefinitions="Auto,Auto,Auto,Auto,*"
          ColumnSpacing="34">
      <StackPanel Spacing="5">
        <TextBlock Classes="section-label" Text="RUNTIME" />
        <TextBlock Classes="metric-value" Text="{Binding RuntimeDisplay}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="5">
        <TextBlock Classes="section-label" Text="CAPTURED AT" />
        <TextBlock Classes="metric-value" Text="{Binding CapturedAtDisplay}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="5">
        <TextBlock Classes="section-label" Text="OBJECTS" />
        <TextBlock Classes="metric-value" Text="{Binding ObjectCountDisplay}" />
      </StackPanel>
      <StackPanel Grid.Column="3" Spacing="5">
        <TextBlock Classes="section-label" Text="HEAP SIZE" />
        <TextBlock Classes="metric-value" Text="{Binding HeapSizeDisplay}" />
      </StackPanel>
      <StackPanel Grid.Column="4"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,2,2">
        <TextBlock Classes="secondary"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding SourcePath}"
                   Text="{Binding SourcePath}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2"
          IsVisible="{Binding IsReady}"
          ColumnDefinitions="*,Auto,Auto,Auto"
          ColumnSpacing="8">
      <StackPanel Spacing="5">
        <TextBlock Classes="section-label" Text="SEARCH" />
        <TextBox MaxWidth="380"
                 AutomationProperties.Name="Search types"
                 PlaceholderText="Search type or namespace"
                 Text="{Binding Types.SearchText}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="5">
        <TextBlock Classes="section-label" Text="ASSEMBLY" />
        <ComboBox Width="170"
                  AutomationProperties.Name="Assembly filter"
                  ItemsSource="{Binding Types.AssemblyFilters}"
                  SelectedItem="{Binding Types.SelectedAssemblyFilter, Mode=TwoWay}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="5">
        <TextBlock Classes="section-label" Text="MIN SIZE" />
        <TextBox Width="110"
                 AutomationProperties.Name="Minimum size filter"
                 PlaceholderText="e.g. 100 KB"
                 Text="{Binding Types.MinimumSizeText}" />
      </StackPanel>
      <StackPanel Grid.Column="3"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,2,8">
        <TextBlock Classes="secondary"
                   FontSize="12"
                   Text="{Binding Types.ShownSummary}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="3"
          RowDefinitions="2*,6,*">
      <Grid Grid.Row="0"
            RowDefinitions="Auto,*">
        <StackPanel IsVisible="{Binding ShowRetainedSizeProgress}"
                    Margin="10,6,10,0"
                    VerticalAlignment="Top"
                    Spacing="6">
          <ProgressBar Height="2"
                       Minimum="0"
                       Maximum="1"
                       IsVisible="{Binding IsComputingRetainedSizes}"
                       Value="{Binding RetainedSizeProgress}"
                       AutomationProperties.Name="Computing retained sizes"
                       AutomationProperties.LiveSetting="Polite" />
          <TextBlock IsVisible="{Binding IsComputingRetainedSizes}"
                     Classes="secondary"
                     FontSize="12"
                     Text="{Binding RetainedSizeStatusText}" />
          <Button IsVisible="{Binding IsComputingRetainedSizes}"
                  Classes="dashboard-action"
                  HorizontalAlignment="Left"
                  AutomationProperties.Name="Cancel retained size analysis"
                  Command="{Binding CancelRetainedSizeCommand}"
                  Content="Cancel" />
          <Border IsVisible="{Binding HasRetainedSizeError}"
                  Padding="12,9"
                  CornerRadius="{DynamicResource AppCornerRadius}"
                  AutomationProperties.Name="{Binding RetainedSizeStatusText}"
                  AutomationProperties.LiveSetting="Assertive"
                  Background="{DynamicResource AppErrorSurfaceBrush}">
            <TextBlock Foreground="{DynamicResource AppErrorTextBrush}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Text="{Binding RetainedSizeStatusText}" />
          </Border>
        </StackPanel>

        <Grid Grid.Row="1">
          <StackPanel IsVisible="{Binding ShowLoading}"
                      Margin="10,22"
                      Spacing="16">
            <ProgressBar Height="2"
                         IsIndeterminate="True"
                         AutomationProperties.Name="Analyzing snapshot"
                         AutomationProperties.LiveSetting="Polite" />
            <TextBlock Classes="secondary"
                       FontSize="13"
                       Text="Analyzing the managed heap..." />
            <Button Classes="dashboard-action"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Cancel snapshot analysis"
                    Command="{Binding CancelLoadCommand}"
                    Content="Cancel" />
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,140,100,90" ColumnSpacing="28">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
                <Border Grid.Column="3" Classes="skeleton" />
              </Grid>
              <Grid ColumnDefinitions="*,140,100,90" ColumnSpacing="28">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
                <Border Grid.Column="3" Classes="skeleton" />
              </Grid>
              <Grid ColumnDefinitions="*,140,100,90" ColumnSpacing="28">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
                <Border Grid.Column="3" Classes="skeleton" />
              </Grid>
            </StackPanel>
          </StackPanel>

          <Grid IsVisible="{Binding ShowError}" Margin="0,18">
            <views:ErrorDetailsView DataContext="{Binding Error}" />
          </Grid>

          <Border IsVisible="{Binding ShowEmpty}"
                  Margin="0,18"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource AppCornerRadius}"
                  Padding="24">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
              <TextBlock HorizontalAlignment="Center"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                         Text="No managed types found" />
              <TextBlock HorizontalAlignment="Center"
                         Classes="secondary"
                         Text="The dump contains no walkable managed heap types." />
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding ShowNoFilteredTypes}"
                  Margin="0,18"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource AppCornerRadius}"
                  Padding="24">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
              <TextBlock HorizontalAlignment="Center"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                         Text="No types match these filters" />
              <TextBlock HorizontalAlignment="Center"
                         Classes="secondary"
                         Text="Adjust the search, assembly, or minimum size filters." />
            </StackPanel>
          </Border>

          <DataGrid IsVisible="{Binding ShowTable}"
                    AutomationProperties.Name="Heap types"
                    AutoGenerateColumns="False"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="True"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    ItemsSource="{Binding Types.FilteredTypes}"
                    SelectedItem="{Binding Types.SelectedType, Mode=TwoWay}">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Copy Type Name"
                          Command="{Binding CopyTypeNameCommand}"
                          CommandParameter="{Binding Types.SelectedType}" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Type" Width="*" SortMemberPath="TypeName" Binding="{Binding TypeName}" />
              <DataGridTextColumn Header="Assembly" Width="190" SortMemberPath="AssemblyName" Binding="{Binding AssemblyName}" />
              <DataGridTextColumn Header="Count" Width="120" SortMemberPath="Type.ObjectCount" Binding="{Binding CountDisplay}" />
              <DataGridTextColumn Header="Shallow size" Width="110" SortMemberPath="Type.ShallowSize" Binding="{Binding ShallowSizeDisplay}" />
              <DataGridTextColumn Header="Retained size" Width="110" SortMemberPath="RetainedSize" Binding="{Binding RetainedSizeDisplay}" />
            </DataGrid.Columns>
          </DataGrid>

        </Grid>
      </Grid>

      <GridSplitter Grid.Row="1"
                    Height="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource AppBorderBrush}" />

      <Grid Grid.Row="2"
            ColumnDefinitions="*,6,*,6,*">
        <Border Grid.Column="0"
                MinHeight="150"
                MinWidth="300"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource AppCornerRadius}"
                Padding="14,10">
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="8">
          <Grid Grid.Row="0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="16">
            <StackPanel Spacing="2">
              <TextBlock Classes="section-label" Text="INSTANCES" />
              <TextBlock MaxWidth="520"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding ObjectInstances.TypeName}"
                         Text="{Binding ObjectInstances.TypeName}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Spacing="12">
              <TextBlock Classes="secondary"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Text="{Binding ObjectInstances.SummaryDisplay}" />
              <ProgressBar Width="140"
                           Height="2"
                           IsIndeterminate="True"
                           IsVisible="{Binding ObjectInstances.ShowLoading}"
                           AutomationProperties.Name="Loading object instances"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2">
            <StackPanel IsVisible="{Binding ObjectInstances.ShowIdle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,12"
                        Spacing="6">
              <TextBlock HorizontalAlignment="Center"
                         Classes="secondary"
                         Text="Select a type to view its instances" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ObjectInstances.ShowLoading}"
                        Margin="0,8"
                        Spacing="10">
              <Button Classes="dashboard-action"
                      HorizontalAlignment="Left"
                      AutomationProperties.Name="Cancel loading object instances"
                      Command="{Binding ObjectInstances.CancelCommand}"
                      Content="Cancel" />
              <Grid ColumnDefinitions="*,120,110" ColumnSpacing="8">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
              </Grid>
              <Grid ColumnDefinitions="*,120,110" ColumnSpacing="8">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
              </Grid>
              <Grid ColumnDefinitions="*,120,110" ColumnSpacing="8">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
              </Grid>
            </StackPanel>

            <Grid IsVisible="{Binding ObjectInstances.ShowError}" Margin="0,6">
              <views:ErrorDetailsView DataContext="{Binding ObjectInstances.Error}" />
            </Grid>

            <StackPanel IsVisible="{Binding ObjectInstances.ShowEmpty}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,12"
                        Spacing="4">
              <TextBlock HorizontalAlignment="Center"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                         Text="No instances found" />
              <TextBlock HorizontalAlignment="Center"
                         Classes="secondary"
                         Text="This type has no objects on the managed heap." />
            </StackPanel>

            <DataGrid IsVisible="{Binding ObjectInstances.ShowTable}"
                      AutomationProperties.Name="Object instances"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      ItemsSource="{Binding ObjectInstances.Instances}"
                      SelectedItem="{Binding ObjectInstances.SelectedInstance, Mode=TwoWay}">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Copy Object Address"
                            Command="{Binding CopyObjectAddressCommand}"
                            CommandParameter="{Binding ObjectInstances.SelectedInstance}" />
                  <Separator />
                  <MenuItem Header="Show Outgoing References"
                            Command="{Binding ShowOutgoingReferencesCommand}"
                            CommandParameter="{Binding ObjectInstances.SelectedInstance}" />
                  <MenuItem Header="Show Incoming References"
                            Command="{Binding ShowIncomingReferencesCommand}"
                            CommandParameter="{Binding ObjectInstances.SelectedInstance}" />
                  <MenuItem Header="Show Path to Root"
                            Command="{Binding ShowPathToRootCommand}"
                            CommandParameter="{Binding ObjectInstances.SelectedInstance}" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Address" Width="*" SortMemberPath="Instance.Address" Binding="{Binding AddressDisplay}" />
                <DataGridTextColumn Header="Size" Width="120" SortMemberPath="Instance.Size" Binding="{Binding SizeDisplay}" />
                <DataGridTextColumn Header="Generation" Width="110" SortMemberPath="GenerationDisplay" Binding="{Binding GenerationDisplay}" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1"
                    Width="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource AppBorderBrush}" />

      <Border Grid.Column="2"
              MinHeight="150"
              MinWidth="300"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource AppCornerRadius}"
              Padding="14,10">
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="8">
          <Grid Grid.Row="0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="16">
            <StackPanel Spacing="2">
              <StackPanel Orientation="Horizontal"
                          Spacing="10">
                <TextBlock Classes="section-label"
                           VerticalAlignment="Center"
                           Text="REFERENCES" />
                <Button Classes="direction-button"
                        Classes.active="{Binding ObjectReferences.IsOutgoing}"
                        AutomationProperties.Name="Show outgoing references"
                        Command="{Binding ObjectReferences.ShowOutgoingCommand}"
                        Content="Outgoing" />
                <Button Classes="direction-button"
                        Classes.active="{Binding ObjectReferences.IsIncoming}"
                        AutomationProperties.Name="Show incoming references"
                        Command="{Binding ObjectReferences.ShowIncomingCommand}"
                        Content="Incoming" />
              </StackPanel>
              <TextBlock MaxWidth="420"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding ObjectReferences.ObjectTypeName}"
                         Text="{Binding ObjectReferences.ObjectTypeName}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Spacing="12">
              <TextBlock Classes="secondary"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Text="{Binding ObjectReferences.AddressDisplay}" />
              <TextBlock Classes="secondary"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Text="{Binding ObjectReferences.SummaryDisplay}" />
              <ProgressBar Width="140"
                           Height="2"
                           IsIndeterminate="True"
                           IsVisible="{Binding ObjectReferences.ShowLoading}"
                           AutomationProperties.Name="Loading object references"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2">
            <StackPanel IsVisible="{Binding ObjectReferences.ShowIdle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,12"
                        Spacing="6">
              <TextBlock HorizontalAlignment="Center"
                         Classes="secondary"
                         Text="Select an object and choose Show Outgoing or Show Incoming References" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ObjectReferences.ShowLoading}"
                        Margin="0,8"
                        Spacing="10">
              <Button Classes="dashboard-action"
                      HorizontalAlignment="Left"
                      AutomationProperties.Name="Cancel loading object references"
                      Command="{Binding ObjectReferences.CancelCommand}"
                      Content="Cancel" />
              <Grid ColumnDefinitions="*,120,140,*" ColumnSpacing="8">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
                <Border Grid.Column="3" Classes="skeleton" />
              </Grid>
              <Grid ColumnDefinitions="*,120,140,*" ColumnSpacing="8">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
                <Border Grid.Column="3" Classes="skeleton" />
              </Grid>
              <Grid ColumnDefinitions="*,120,140,*" ColumnSpacing="8">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
                <Border Grid.Column="3" Classes="skeleton" />
              </Grid>
            </StackPanel>

            <Grid IsVisible="{Binding ObjectReferences.ShowError}" Margin="0,6">
              <views:ErrorDetailsView DataContext="{Binding ObjectReferences.Error}" />
            </Grid>

            <StackPanel IsVisible="{Binding ObjectReferences.ShowEmpty}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,12"
                        Spacing="4">
              <TextBlock HorizontalAlignment="Center"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                         Text="No references" />
              <TextBlock HorizontalAlignment="Center"
                         Classes="secondary"
                         Text="{Binding ObjectReferences.EmptyHint}" />
            </StackPanel>

            <DataGrid IsVisible="{Binding ObjectReferences.ShowTable}"
                      AutomationProperties.Name="Object references"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      ItemsSource="{Binding ObjectReferences.References}"
                      SelectedItem="{Binding ObjectReferences.SelectedReference, Mode=TwoWay}"
                      DoubleTapped="OnReferencesListDoubleTapped">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Copy Object Address"
                            Command="{Binding CopyObjectAddressCommand}"
                            CommandParameter="{Binding ObjectReferences.SelectedReference}" />
                  <Separator />
                  <MenuItem Header="Show Outgoing References"
                            Command="{Binding ShowOutgoingReferencesCommand}"
                            CommandParameter="{Binding ObjectReferences.SelectedReference}" />
                  <MenuItem Header="Show Incoming References"
                            Command="{Binding ShowIncomingReferencesCommand}"
                            CommandParameter="{Binding ObjectReferences.SelectedReference}" />
                  <MenuItem Header="Show Path to Root"
                            Command="{Binding ShowPathToRootCommand}"
                            CommandParameter="{Binding ObjectReferences.SelectedReference}" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Field" Width="*" SortMemberPath="FieldDisplay" Binding="{Binding FieldDisplay}" />
                <DataGridTextColumn Header="Kind" Width="120" SortMemberPath="KindDisplay" Binding="{Binding KindDisplay}" />
                <DataGridTextColumn Header="Address" Width="140" SortMemberPath="EndpointAddress" Binding="{Binding AddressDisplay}" />
                <DataGridTextColumn Header="Type" Width="*" SortMemberPath="TypeNameDisplay" Binding="{Binding TypeNameDisplay}" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3"
                    Width="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource AppBorderBrush}" />

      <Border Grid.Column="4"
              MinHeight="150"
              MinWidth="300"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource AppCornerRadius}"
              Padding="14,10">
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="8">
          <Grid Grid.Row="0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="16">
            <StackPanel Spacing="2">
              <TextBlock Classes="section-label" Text="PATH TO ROOT" />
              <TextBlock MaxWidth="420"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding GcRoots.ObjectTypeName}"
                         Text="{Binding GcRoots.ObjectTypeName}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Spacing="12">
              <TextBlock Classes="secondary"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Text="{Binding GcRoots.AddressDisplay}" />
              <TextBlock Classes="secondary"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Text="{Binding GcRoots.SummaryDisplay}" />
              <ProgressBar Width="140"
                           Height="2"
                           IsIndeterminate="True"
                           IsVisible="{Binding GcRoots.ShowLoading}"
                           AutomationProperties.Name="Loading paths to root"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2">
            <StackPanel IsVisible="{Binding GcRoots.ShowIdle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,12"
                        Spacing="6">
              <TextBlock HorizontalAlignment="Center"
                         Classes="secondary"
                         Text="Select an object and choose Show Path to Root" />
            </StackPanel>

            <StackPanel IsVisible="{Binding GcRoots.ShowLoading}"
                        Margin="0,8"
                        Spacing="10">
              <Button Classes="dashboard-action"
                      HorizontalAlignment="Left"
                      AutomationProperties.Name="Cancel finding paths to root"
                      Command="{Binding GcRoots.CancelCommand}"
                      Content="Cancel" />
              <Grid ColumnDefinitions="*,120,140,*" ColumnSpacing="8">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
                <Border Grid.Column="3" Classes="skeleton" />
              </Grid>
              <Grid ColumnDefinitions="*,120,140,*" ColumnSpacing="8">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
                <Border Grid.Column="3" Classes="skeleton" />
              </Grid>
              <Grid ColumnDefinitions="*,120,140,*" ColumnSpacing="8">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
                <Border Grid.Column="3" Classes="skeleton" />
              </Grid>
            </StackPanel>

            <Grid IsVisible="{Binding GcRoots.ShowError}" Margin="0,6">
              <views:ErrorDetailsView DataContext="{Binding GcRoots.Error}" />
            </Grid>

            <StackPanel IsVisible="{Binding GcRoots.ShowEmpty}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,12"
                        Spacing="4">
              <TextBlock HorizontalAlignment="Center"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                         Text="No path to root" />
              <TextBlock HorizontalAlignment="Center"
                         Classes="secondary"
                         Text="{Binding GcRoots.EmptyHint}" />
            </StackPanel>

            <DataGrid IsVisible="{Binding GcRoots.ShowTable}"
                      AutomationProperties.Name="Paths to root"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      ItemsSource="{Binding GcRoots.Rows}"
                      SelectedItem="{Binding GcRoots.SelectedRow, Mode=TwoWay}"
                      DoubleTapped="OnPathsListDoubleTapped">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Copy Object Address"
                            Command="{Binding CopyObjectAddressCommand}"
                            CommandParameter="{Binding GcRoots.SelectedRow}" />
                  <MenuItem Header="Copy Path to Root"
                            Command="{Binding CopyGcRootPathCommand}"
                            CommandParameter="{Binding GcRoots.SelectedRow}" />
                  <Separator />
                  <MenuItem Header="Show Outgoing References"
                            Command="{Binding ShowOutgoingReferencesCommand}"
                            CommandParameter="{Binding GcRoots.SelectedRow}" />
                  <MenuItem Header="Show Incoming References"
                            Command="{Binding ShowIncomingReferencesCommand}"
                            CommandParameter="{Binding GcRoots.SelectedRow}" />
                  <MenuItem Header="Show Path to Root"
                            Command="{Binding ShowPathToRootCommand}"
                            CommandParameter="{Binding GcRoots.SelectedRow}" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Field" Width="*" SortMemberPath="FieldDisplay">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="objects:GcRootRowViewModel">
                      <TextBlock Margin="{Binding IndentMargin}"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding FieldDisplay}"
                                 Text="{Binding FieldDisplay}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Kind" Width="120" SortMemberPath="KindDisplay" Binding="{Binding KindDisplay}" />
                <DataGridTextColumn Header="Address" Width="140" SortMemberPath="EndpointAddress" Binding="{Binding AddressDisplay}" />
                <DataGridTextColumn Header="Type" Width="*" SortMemberPath="TypeNameDisplay" Binding="{Binding TypeNameDisplay}" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Grid>
      </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
