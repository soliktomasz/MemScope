<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MemoryProfiler.App.ViewModels"
             xmlns:types="using:MemoryProfiler.App.ViewModels.Types"
             xmlns:objects="using:MemoryProfiler.App.ViewModels.Objects"
             x:Class="MemoryProfiler.App.Views.SnapshotView"
             x:DataType="vm:SnapshotViewModel"
             x:CompileBindings="True">
  <UserControl.Styles>
    <Style Selector="TextBlock.dashboard-title">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.section-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.metric-value">
      <Setter Property="FontFamily" Value="Cascadia Mono, Menlo, Consolas" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.mono-data">
      <Setter Property="FontFamily" Value="Cascadia Mono, Menlo, Consolas" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.table-header">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.dashboard-action">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="15,7" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.table-header">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.skeleton">
      <Setter Property="Height" Value="12" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}" />
    </Style>
    <Style Selector="ListBox.type-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.type-list ListBoxItem">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
    </Style>
    <Style Selector="ListBox.instance-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.instance-list ListBoxItem">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
    </Style>
    <Style Selector="ListBox.reference-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.reference-list ListBoxItem">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
    </Style>
    <Style Selector="Button.direction-button">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="12,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
    </Style>
    <Style Selector="Button.direction-button.active">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="32,26,32,28"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="16">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <StackPanel Spacing="4">
        <TextBlock Classes="dashboard-title" Text="Snapshot" />
        <TextBlock Classes="secondary"
                   FontSize="13"
                   Text="{Binding ProcessDescription}" />
      </StackPanel>
      <Button Grid.Column="1"
              Classes="dashboard-action"
              VerticalAlignment="Top"
              Command="{Binding CloseCommand}"
              Content="Close" />
    </Grid>

    <Grid Grid.Row="1"
          IsVisible="{Binding IsReady}"
          ColumnDefinitions="Auto,Auto,Auto,Auto,*"
          ColumnSpacing="34">
      <StackPanel Spacing="5">
        <TextBlock Classes="section-label" Text="RUNTIME" />
        <TextBlock Classes="metric-value" Text="{Binding RuntimeDisplay}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="5">
        <TextBlock Classes="section-label" Text="CAPTURED AT" />
        <TextBlock Classes="metric-value" Text="{Binding CapturedAtDisplay}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="5">
        <TextBlock Classes="section-label" Text="OBJECTS" />
        <TextBlock Classes="metric-value" Text="{Binding ObjectCountDisplay}" />
      </StackPanel>
      <StackPanel Grid.Column="3" Spacing="5">
        <TextBlock Classes="section-label" Text="HEAP SIZE" />
        <TextBlock Classes="metric-value" Text="{Binding HeapSizeDisplay}" />
      </StackPanel>
      <StackPanel Grid.Column="4"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,2,2">
        <TextBlock Classes="secondary"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding SourcePath}"
                   Text="{Binding SourcePath}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2"
          IsVisible="{Binding IsReady}"
          ColumnDefinitions="*,Auto,Auto,Auto"
          ColumnSpacing="8">
      <StackPanel Spacing="5">
        <TextBlock Classes="section-label" Text="SEARCH" />
        <TextBox MaxWidth="380"
                 AutomationProperties.Name="Search types"
                 Watermark="Search type or namespace"
                 Text="{Binding Types.SearchText}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="5">
        <TextBlock Classes="section-label" Text="ASSEMBLY" />
        <ComboBox Width="170"
                  AutomationProperties.Name="Assembly filter"
                  ItemsSource="{Binding Types.AssemblyFilters}"
                  SelectedItem="{Binding Types.SelectedAssemblyFilter, Mode=TwoWay}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="5">
        <TextBlock Classes="section-label" Text="MIN SIZE" />
        <TextBox Width="110"
                 AutomationProperties.Name="Minimum size filter"
                 Watermark="e.g. 100 KB"
                 Text="{Binding Types.MinimumSizeText}" />
      </StackPanel>
      <StackPanel Grid.Column="3"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,2,8">
        <TextBlock Classes="secondary"
                   FontSize="12"
                   Text="{Binding Types.ShownSummary}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="3"
          RowDefinitions="2*,6,*">
      <Grid Grid.Row="0"
            RowDefinitions="Auto,*">
        <Grid Grid.Row="0"
              IsVisible="{Binding IsReady}"
              ColumnDefinitions="*,190,120,110,100"
              ColumnSpacing="8"
              Background="{DynamicResource AppSurfaceSubtleBrush}">
          <Button Grid.Column="0"
                  Classes="table-header"
                  Command="{Binding Types.SortByTypeNameCommand}"
                  ToolTip.Tip="{Binding Types.TypeNameSortDescription}"
                  Content="{Binding Types.TypeNameHeader}" />
          <Button Grid.Column="1"
                  Classes="table-header"
                  Command="{Binding Types.SortByAssemblyCommand}"
                  ToolTip.Tip="{Binding Types.AssemblySortDescription}"
                  Content="{Binding Types.AssemblyHeader}" />
          <Button Grid.Column="2"
                  Classes="table-header"
                  HorizontalContentAlignment="Right"
                  Command="{Binding Types.SortByCountCommand}"
                  ToolTip.Tip="{Binding Types.CountSortDescription}"
                  Content="{Binding Types.CountHeader}" />
          <Button Grid.Column="3"
                  Classes="table-header"
                  HorizontalContentAlignment="Right"
                  Command="{Binding Types.SortByShallowSizeCommand}"
                  ToolTip.Tip="{Binding Types.ShallowSizeSortDescription}"
                  Content="{Binding Types.ShallowSizeHeader}" />
          <Button Grid.Column="4"
                  Classes="table-header"
                  HorizontalContentAlignment="Right"
                  Command="{Binding Types.SortByRetainedSizeCommand}"
                  ToolTip.Tip="{Binding Types.RetainedSizeSortDescription}"
                  Content="{Binding Types.RetainedSizeHeader}" />
        </Grid>

        <Grid Grid.Row="1">
          <StackPanel IsVisible="{Binding ShowLoading}"
                      Margin="10,22"
                      Spacing="16">
            <ProgressBar Height="2"
                         IsIndeterminate="True"
                         AutomationProperties.Name="Analyzing snapshot"
                         AutomationProperties.LiveSetting="Polite" />
            <TextBlock Classes="secondary"
                       FontSize="13"
                       Text="Analyzing the managed heap..." />
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,140,100,90" ColumnSpacing="28">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
                <Border Grid.Column="3" Classes="skeleton" />
              </Grid>
              <Grid ColumnDefinitions="*,140,100,90" ColumnSpacing="28">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
                <Border Grid.Column="3" Classes="skeleton" />
              </Grid>
              <Grid ColumnDefinitions="*,140,100,90" ColumnSpacing="28">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
                <Border Grid.Column="3" Classes="skeleton" />
              </Grid>
            </StackPanel>
          </StackPanel>

          <Border IsVisible="{Binding ShowError}"
                  Margin="0,18"
                  Padding="12,9"
                  CornerRadius="{DynamicResource AppCornerRadius}"
                  AutomationProperties.Name="{Binding ErrorMessage}"
                  AutomationProperties.LiveSetting="Assertive"
                  Background="{DynamicResource AppErrorSurfaceBrush}">
            <TextBlock Foreground="{DynamicResource AppErrorTextBrush}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Text="{Binding ErrorMessage}" />
          </Border>

          <Border IsVisible="{Binding ShowEmpty}"
                  Margin="0,18"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource AppCornerRadius}"
                  Padding="24">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
              <TextBlock HorizontalAlignment="Center"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                         Text="No managed types found" />
              <TextBlock HorizontalAlignment="Center"
                         Classes="secondary"
                         Text="The dump contains no walkable managed heap types." />
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding ShowNoFilteredTypes}"
                  Margin="0,18"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource AppCornerRadius}"
                  Padding="24">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
              <TextBlock HorizontalAlignment="Center"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                         Text="No types match these filters" />
              <TextBlock HorizontalAlignment="Center"
                         Classes="secondary"
                         Text="Adjust the search, assembly, or minimum size filters." />
            </StackPanel>
          </Border>

          <ListBox Classes="type-list"
                   IsVisible="{Binding ShowTable}"
                   AutomationProperties.Name="Heap types"
                   ItemsSource="{Binding Types.FilteredTypes}"
                   SelectedItem="{Binding Types.SelectedType, Mode=TwoWay}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="types:TypeRowViewModel">
                <Grid ColumnDefinitions="*,190,120,110,100"
                      ColumnSpacing="8"
                      MinHeight="34">
                  <TextBlock Grid.Column="0"
                             Margin="8,0"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding TypeName}"
                             Text="{Binding TypeName}" />
                  <TextBlock Grid.Column="1"
                             VerticalAlignment="Center"
                             Classes="secondary"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding AssemblyName}"
                             Text="{Binding AssemblyName}" />
                  <TextBlock Grid.Column="2"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Classes="mono-data"
                             Text="{Binding CountDisplay}" />
                  <TextBlock Grid.Column="3"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Classes="mono-data"
                             Text="{Binding ShallowSizeDisplay}" />
                  <TextBlock Grid.Column="4"
                             IsVisible="{Binding IsRetainedSizeAvailable}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Classes="mono-data"
                             Text="{Binding RetainedSizeDisplay}" />
                  <TextBlock Grid.Column="4"
                             IsVisible="{Binding IsRetainedSizeUnavailable}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Classes="secondary"
                             Text="N/A" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>

      <GridSplitter Grid.Row="1"
                    Height="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource AppBorderBrush}" />

      <Grid Grid.Row="2"
            ColumnDefinitions="*,6,*">
        <Border Grid.Column="0"
                MinHeight="150"
                MinWidth="300"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource AppCornerRadius}"
                Padding="14,10">
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="8">
          <Grid Grid.Row="0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="16">
            <StackPanel Spacing="2">
              <TextBlock Classes="section-label" Text="INSTANCES" />
              <TextBlock MaxWidth="520"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding ObjectInstances.TypeName}"
                         Text="{Binding ObjectInstances.TypeName}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Spacing="12">
              <TextBlock Classes="secondary"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Text="{Binding ObjectInstances.SummaryDisplay}" />
              <ProgressBar Width="140"
                           Height="2"
                           IsIndeterminate="True"
                           IsVisible="{Binding ObjectInstances.ShowLoading}"
                           AutomationProperties.Name="Loading object instances"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1"
                IsVisible="{Binding ObjectInstances.ShowTable}"
                ColumnDefinitions="*,120,110"
                ColumnSpacing="8"
                Background="{DynamicResource AppSurfaceSubtleBrush}">
            <TextBlock Grid.Column="0" Classes="table-header" Text="Address" />
            <TextBlock Grid.Column="1"
                       Classes="table-header"
                       HorizontalAlignment="Right"
                       Text="Size" />
            <TextBlock Grid.Column="2" Classes="table-header" Text="Generation" />
          </Grid>

          <Grid Grid.Row="2">
            <StackPanel IsVisible="{Binding ObjectInstances.ShowIdle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,12"
                        Spacing="6">
              <TextBlock HorizontalAlignment="Center"
                         Classes="secondary"
                         Text="Select a type to view its instances" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ObjectInstances.ShowLoading}"
                        Margin="0,8"
                        Spacing="10">
              <Grid ColumnDefinitions="*,120,110" ColumnSpacing="8">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
              </Grid>
              <Grid ColumnDefinitions="*,120,110" ColumnSpacing="8">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
              </Grid>
              <Grid ColumnDefinitions="*,120,110" ColumnSpacing="8">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
              </Grid>
            </StackPanel>

            <Border IsVisible="{Binding ObjectInstances.ShowError}"
                    Margin="0,6"
                    Padding="12,9"
                    CornerRadius="{DynamicResource AppCornerRadius}"
                    AutomationProperties.Name="{Binding ObjectInstances.ErrorMessage}"
                    AutomationProperties.LiveSetting="Assertive"
                    Background="{DynamicResource AppErrorSurfaceBrush}">
              <TextBlock Foreground="{DynamicResource AppErrorTextBrush}"
                         FontSize="13"
                         TextWrapping="Wrap"
                         Text="{Binding ObjectInstances.ErrorMessage}" />
            </Border>

            <StackPanel IsVisible="{Binding ObjectInstances.ShowEmpty}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,12"
                        Spacing="4">
              <TextBlock HorizontalAlignment="Center"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                         Text="No instances found" />
              <TextBlock HorizontalAlignment="Center"
                         Classes="secondary"
                         Text="This type has no objects on the managed heap." />
            </StackPanel>

            <ListBox Classes="instance-list"
                     IsVisible="{Binding ObjectInstances.ShowTable}"
                     AutomationProperties.Name="Object instances"
                     ItemsSource="{Binding ObjectInstances.Instances}">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Show Outgoing References"
                            Command="{Binding ShowOutgoingReferencesCommand}"
                            CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                  <MenuItem Header="Show Incoming References"
                            Command="{Binding ShowIncomingReferencesCommand}"
                            CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="objects:HeapObjectRowViewModel">
                  <Grid ColumnDefinitions="*,120,110"
                        ColumnSpacing="8"
                        MinHeight="30">
                    <TextBlock Grid.Column="0"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               Classes="mono-data"
                               Text="{Binding AddressDisplay}" />
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Classes="mono-data"
                               Text="{Binding SizeDisplay}" />
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Classes="secondary"
                               Text="{Binding GenerationDisplay}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1"
                    Width="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource AppBorderBrush}" />

      <Border Grid.Column="2"
              MinHeight="150"
              MinWidth="300"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource AppCornerRadius}"
              Padding="14,10">
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="8">
          <Grid Grid.Row="0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="16">
            <StackPanel Spacing="2">
              <StackPanel Orientation="Horizontal"
                          Spacing="10">
                <TextBlock Classes="section-label"
                           VerticalAlignment="Center"
                           Text="REFERENCES" />
                <Button Classes="direction-button"
                        Classes.active="{Binding ObjectReferences.IsOutgoing}"
                        AutomationProperties.Name="Show outgoing references"
                        Command="{Binding ObjectReferences.ShowOutgoingCommand}"
                        Content="Outgoing" />
                <Button Classes="direction-button"
                        Classes.active="{Binding ObjectReferences.IsIncoming}"
                        AutomationProperties.Name="Show incoming references"
                        Command="{Binding ObjectReferences.ShowIncomingCommand}"
                        Content="Incoming" />
              </StackPanel>
              <TextBlock MaxWidth="420"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding ObjectReferences.ObjectTypeName}"
                         Text="{Binding ObjectReferences.ObjectTypeName}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Spacing="12">
              <TextBlock Classes="secondary"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Text="{Binding ObjectReferences.AddressDisplay}" />
              <TextBlock Classes="secondary"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Text="{Binding ObjectReferences.SummaryDisplay}" />
              <ProgressBar Width="140"
                           Height="2"
                           IsIndeterminate="True"
                           IsVisible="{Binding ObjectReferences.ShowLoading}"
                           AutomationProperties.Name="Loading object references"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1"
                IsVisible="{Binding ObjectReferences.ShowTable}"
                ColumnDefinitions="*,120,140,*"
                ColumnSpacing="8"
                Background="{DynamicResource AppSurfaceSubtleBrush}">
            <TextBlock Grid.Column="0" Classes="table-header" Text="Field" />
            <TextBlock Grid.Column="1" Classes="table-header" Text="Kind" />
            <TextBlock Grid.Column="2" Classes="table-header" Text="Address" />
            <TextBlock Grid.Column="3" Classes="table-header" Text="Type" />
          </Grid>

          <Grid Grid.Row="2">
            <StackPanel IsVisible="{Binding ObjectReferences.ShowIdle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,12"
                        Spacing="6">
              <TextBlock HorizontalAlignment="Center"
                         Classes="secondary"
                         Text="Select an object and choose Show Outgoing or Show Incoming References" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ObjectReferences.ShowLoading}"
                        Margin="0,8"
                        Spacing="10">
              <Grid ColumnDefinitions="*,120,140,*" ColumnSpacing="8">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
                <Border Grid.Column="3" Classes="skeleton" />
              </Grid>
              <Grid ColumnDefinitions="*,120,140,*" ColumnSpacing="8">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
                <Border Grid.Column="3" Classes="skeleton" />
              </Grid>
              <Grid ColumnDefinitions="*,120,140,*" ColumnSpacing="8">
                <Border Grid.Column="0" Classes="skeleton" />
                <Border Grid.Column="1" Classes="skeleton" />
                <Border Grid.Column="2" Classes="skeleton" />
                <Border Grid.Column="3" Classes="skeleton" />
              </Grid>
            </StackPanel>

            <Border IsVisible="{Binding ObjectReferences.ShowError}"
                    Margin="0,6"
                    Padding="12,9"
                    CornerRadius="{DynamicResource AppCornerRadius}"
                    AutomationProperties.Name="{Binding ObjectReferences.ErrorMessage}"
                    AutomationProperties.LiveSetting="Assertive"
                    Background="{DynamicResource AppErrorSurfaceBrush}">
              <TextBlock Foreground="{DynamicResource AppErrorTextBrush}"
                         FontSize="13"
                         TextWrapping="Wrap"
                         Text="{Binding ObjectReferences.ErrorMessage}" />
            </Border>

            <StackPanel IsVisible="{Binding ObjectReferences.ShowEmpty}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,12"
                        Spacing="4">
              <TextBlock HorizontalAlignment="Center"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                         Text="No references" />
              <TextBlock HorizontalAlignment="Center"
                         Classes="secondary"
                         Text="{Binding ObjectReferences.EmptyHint}" />
            </StackPanel>

            <ListBox Classes="reference-list"
                     IsVisible="{Binding ObjectReferences.ShowTable}"
                     AutomationProperties.Name="Object references"
                     ItemsSource="{Binding ObjectReferences.References}"
                     DoubleTapped="OnReferencesListDoubleTapped">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Show Outgoing References"
                            Command="{Binding ShowOutgoingReferencesCommand}"
                            CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                  <MenuItem Header="Show Incoming References"
                            Command="{Binding ShowIncomingReferencesCommand}"
                            CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="objects:ObjectReferenceRowViewModel">
                  <Grid ColumnDefinitions="*,120,140,*"
                        ColumnSpacing="8"
                        MinHeight="30">
                    <TextBlock Grid.Column="0"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding FieldDisplay}"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="{Binding FieldDisplay}" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Classes="secondary"
                               Text="{Binding KindDisplay}" />
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Classes="mono-data"
                               Text="{Binding AddressDisplay}" />
                    <TextBlock Grid.Column="3"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Classes="secondary"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding TypeNameDisplay}"
                               Text="{Binding TypeNameDisplay}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
