<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MemoryProfiler.App.ViewModels"
        xmlns:views="using:MemoryProfiler.App.Views"
        x:Class="MemoryProfiler.App.MainWindow"
        x:DataType="vm:StartViewModel"
        x:CompileBindings="True"
        Title="Memory Profiler"
        Icon="/Assets/memscope.ico"
        Width="1080"
        Height="760"
        MinWidth="760"
        MinHeight="640"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.Styles>
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary-action">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Button.column-header">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.skeleton">
      <Setter Property="Height" Value="12" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}" />
    </Style>
    <Style Selector="ListBox.process-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.process-list ListBoxItem">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
    </Style>
  </Window.Styles>

  <Grid>
  <Grid Margin="40,32,40,28"
        IsVisible="{Binding IsStartVisible}"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="22">
    <StackPanel Grid.Row="0" Spacing="5">
      <TextBlock Classes="page-title" Text="Memory Profiler" />
      <TextBlock Classes="secondary"
                 FontSize="14"
                 Text="Inspect managed processes and memory snapshots." />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="action primary-action"
                Command="{Binding AttachToProcessCommand}"
                Content="Attach to Process" />
        <Button Classes="action"
                Command="{Binding OpenDumpCommand}"
                Content="Open Dump" />
        <Button Classes="action"
                Command="{Binding CompareSnapshotsCommand}"
                Content="Compare Snapshots" />
      </StackPanel>

      <Border IsVisible="{Binding HasDumpError}"
              Padding="12,9"
              CornerRadius="{DynamicResource AppCornerRadius}"
              AutomationProperties.Name="{Binding DumpErrorMessage}"
              AutomationProperties.LiveSetting="Assertive"
              Background="{DynamicResource AppErrorSurfaceBrush}">
        <TextBlock Foreground="{DynamicResource AppErrorTextBrush}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Text="{Binding DumpErrorMessage}" />
      </Border>
    </StackPanel>

    <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="28">
        <Border IsVisible="{Binding IsProcessPickerVisible}"
                Padding="0,20,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0">
          <Grid RowDefinitions="Auto,Auto,Auto,300,Auto"
                RowSpacing="12">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Classes="section-title"
                           Text="Attach to a .NET process" />
                <TextBlock Classes="secondary"
                           FontSize="13"
                           Text="Select a running process to inspect." />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="action"
                      MinHeight="34"
                      Padding="14,6"
                      Command="{Binding ProcessPicker.RefreshCommand}"
                      Content="Refresh" />
            </Grid>

            <ProgressBar Grid.Row="1"
                         Height="2"
                         Margin="0,1,0,0"
                         AutomationProperties.Name="Discovering .NET processes"
                         AutomationProperties.LiveSetting="Polite"
                         IsVisible="{Binding ProcessPicker.IsLoading}"
                         IsIndeterminate="True" />

            <Border Grid.Row="2"
                    IsVisible="{Binding ProcessPicker.HasError}"
                    Padding="12,9"
                    CornerRadius="{DynamicResource AppCornerRadius}"
                    AutomationProperties.Name="{Binding ProcessPicker.ErrorMessage}"
                    AutomationProperties.LiveSetting="Assertive"
                    Background="{DynamicResource AppErrorSurfaceBrush}">
              <TextBlock Foreground="{DynamicResource AppErrorTextBrush}"
                         FontSize="13"
                         TextWrapping="Wrap"
                         Text="{Binding ProcessPicker.ErrorMessage}" />
            </Border>

            <Grid Grid.Row="3">
              <Grid IsVisible="{Binding ProcessPicker.HasProcesses}"
                    RowDefinitions="Auto,*">
                <Grid Grid.Row="0"
                      ColumnDefinitions="120,*,190"
                      Background="{DynamicResource AppSurfaceSubtleBrush}">
                  <Button Grid.Column="0"
                          Classes="column-header"
                          Command="{Binding ProcessPicker.SortByProcessIdCommand}"
                          ToolTip.Tip="{Binding ProcessPicker.ProcessIdSortDescription}"
                          Content="{Binding ProcessPicker.ProcessIdHeader}" />
                  <Button Grid.Column="1"
                          Classes="column-header"
                          Command="{Binding ProcessPicker.SortByNameCommand}"
                          ToolTip.Tip="{Binding ProcessPicker.NameSortDescription}"
                          Content="{Binding ProcessPicker.NameHeader}" />
                  <Button Grid.Column="2"
                          Classes="column-header"
                          Command="{Binding ProcessPicker.SortByRuntimeCommand}"
                          ToolTip.Tip="{Binding ProcessPicker.RuntimeSortDescription}"
                          Content="{Binding ProcessPicker.RuntimeHeader}" />
                </Grid>

                <ListBox Grid.Row="1"
                         Classes="process-list"
                         AutomationProperties.Name="Attachable .NET processes"
                         ItemsSource="{Binding ProcessPicker.Processes}"
                         SelectedItem="{Binding ProcessPicker.SelectedProcess, Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProcessRowViewModel">
                      <Grid ColumnDefinitions="120,*,190"
                            MinHeight="38">
                        <TextBlock Grid.Column="0"
                                   Margin="10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Text="{Binding ProcessId}" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Name}" />
                        <TextBlock Grid.Column="2"
                                   Margin="10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding RuntimeDisplay}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>

              <StackPanel IsVisible="{Binding ProcessPicker.ShowLoadingPlaceholders}"
                          Spacing="18"
                          Margin="10,22">
                <Grid ColumnDefinitions="90,*,150" ColumnSpacing="28">
                  <Border Grid.Column="0" Classes="skeleton" />
                  <Border Grid.Column="1" Classes="skeleton" />
                  <Border Grid.Column="2" Classes="skeleton" />
                </Grid>
                <Grid ColumnDefinitions="90,*,150" ColumnSpacing="28">
                  <Border Grid.Column="0" Classes="skeleton" />
                  <Border Grid.Column="1" Classes="skeleton" />
                  <Border Grid.Column="2" Classes="skeleton" />
                </Grid>
                <Grid ColumnDefinitions="90,*,150" ColumnSpacing="28">
                  <Border Grid.Column="0" Classes="skeleton" />
                  <Border Grid.Column="1" Classes="skeleton" />
                  <Border Grid.Column="2" Classes="skeleton" />
                </Grid>
              </StackPanel>

              <StackPanel IsVisible="{Binding ProcessPicker.IsEmpty}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="No attachable .NET processes found"
                          AutomationProperties.LiveSetting="Polite"
                          Spacing="6">
                <TextBlock HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           Text="No attachable .NET processes found" />
                <TextBlock Classes="secondary"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Text="Start a .NET application, then refresh the list." />
              </StackPanel>
            </Grid>

            <Button Grid.Row="4"
                    Classes="action primary-action"
                    HorizontalAlignment="Right"
                    Command="{Binding AttachSelectedProcessCommand}"
                    Content="Start profiling" />
          </Grid>
        </Border>

        <Border Padding="0,20,0,8"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0">
          <StackPanel Spacing="10">
            <TextBlock Classes="section-title" Text="Recent Sessions" />
            <Border Padding="0,2,0,0">
              <TextBlock Classes="secondary"
                         FontSize="13"
                         Text="No recent sessions yet." />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
    <Grid IsVisible="{Binding IsLiveSessionVisible}">
      <views:LiveSessionView DataContext="{Binding LiveSession}" />
    </Grid>
    <Grid IsVisible="{Binding IsSnapshotVisible}">
      <views:SnapshotView DataContext="{Binding Snapshot}" />
    </Grid>
    <Grid IsVisible="{Binding IsComparisonVisible}">
      <views:ComparisonView DataContext="{Binding Comparison}" />
    </Grid>
  </Grid>
</Window>
