<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MemoryProfiler.App.ViewModels"
        xmlns:views="using:MemoryProfiler.App.Views"
        x:Class="MemoryProfiler.App.MainWindow"
        x:DataType="vm:StartViewModel"
        x:CompileBindings="True"
        Title="Memory Profiler"
        Icon="/Assets/memscope.ico"
        Width="1080"
        Height="760"
        MinWidth="760"
        MinHeight="640"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.Styles>
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary-action">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Button.column-header">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.skeleton">
      <Setter Property="Height" Value="12" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}" />
    </Style>
    <Style Selector="ListBox.process-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.process-list ListBoxItem">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
    </Style>
  </Window.Styles>

  <Grid>
  <Grid Margin="40,32,40,28"
        IsVisible="{Binding IsStartVisible}"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="22">
    <StackPanel Grid.Row="0" Spacing="5">
      <TextBlock Classes="page-title" Text="Memory Profiler" />
      <TextBlock Classes="secondary"
                 FontSize="14"
                 Text="Inspect managed processes and memory snapshots." />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="action primary-action"
                Command="{Binding AttachToProcessCommand}"
                Content="Attach to Process" />
        <Button Classes="action"
                Command="{Binding OpenDumpCommand}"
                Content="Open Dump" />
        <Button Classes="action"
                Command="{Binding CompareSnapshotsCommand}"
                Content="Compare Snapshots" />
      </StackPanel>

      <Grid IsVisible="{Binding HasDumpError}">
        <views:ErrorDetailsView DataContext="{Binding DumpError}" />
      </Grid>
    </StackPanel>

    <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="28">
        <Border IsVisible="{Binding IsProcessPickerVisible}"
                Padding="0,20,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0">
          <Grid RowDefinitions="Auto,Auto,Auto,300,Auto"
                RowSpacing="12">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Classes="section-title"
                           Text="Attach to a .NET process" />
                <TextBlock Classes="secondary"
                           FontSize="13"
                           Text="Select a running process to inspect." />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="action"
                      MinHeight="34"
                      Padding="14,6"
                      Command="{Binding ProcessPicker.RefreshCommand}"
                      Content="Refresh" />
            </Grid>

            <ProgressBar Grid.Row="1"
                         Height="2"
                         Margin="0,1,0,0"
                         AutomationProperties.Name="Discovering .NET processes"
                         AutomationProperties.LiveSetting="Polite"
                         IsVisible="{Binding ProcessPicker.IsLoading}"
                         IsIndeterminate="True" />

            <Grid Grid.Row="2" IsVisible="{Binding ProcessPicker.HasError}">
              <views:ErrorDetailsView DataContext="{Binding ProcessPicker.Error}" />
            </Grid>

            <Grid Grid.Row="3">
              <DataGrid IsVisible="{Binding ProcessPicker.HasProcesses}"
                        AutoGenerateColumns="False"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="True"
                        IsReadOnly="True"
                        GridLinesVisibility="Horizontal"
                        AutomationProperties.Name="Attachable .NET processes"
                        ItemsSource="{Binding ProcessPicker.Processes}"
                        SelectedItem="{Binding ProcessPicker.SelectedProcess, Mode=TwoWay}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="PID"
                                      Width="120"
                                      SortMemberPath="ProcessId"
                                      Binding="{Binding ProcessId}" />
                  <DataGridTextColumn Header="Process"
                                      Width="*"
                                      SortMemberPath="Name"
                                      Binding="{Binding Name}" />
                  <DataGridTextColumn Header="Runtime"
                                      Width="190"
                                      SortMemberPath="RuntimeDisplay"
                                      Binding="{Binding RuntimeDisplay}" />
                </DataGrid.Columns>
              </DataGrid>

              <StackPanel IsVisible="{Binding ProcessPicker.ShowLoadingPlaceholders}"
                          Spacing="18"
                          Margin="10,22">
                <Grid ColumnDefinitions="90,*,150" ColumnSpacing="28">
                  <Border Grid.Column="0" Classes="skeleton" />
                  <Border Grid.Column="1" Classes="skeleton" />
                  <Border Grid.Column="2" Classes="skeleton" />
                </Grid>
                <Grid ColumnDefinitions="90,*,150" ColumnSpacing="28">
                  <Border Grid.Column="0" Classes="skeleton" />
                  <Border Grid.Column="1" Classes="skeleton" />
                  <Border Grid.Column="2" Classes="skeleton" />
                </Grid>
                <Grid ColumnDefinitions="90,*,150" ColumnSpacing="28">
                  <Border Grid.Column="0" Classes="skeleton" />
                  <Border Grid.Column="1" Classes="skeleton" />
                  <Border Grid.Column="2" Classes="skeleton" />
                </Grid>
              </StackPanel>

              <StackPanel IsVisible="{Binding ProcessPicker.IsEmpty}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="No attachable .NET processes found"
                          AutomationProperties.LiveSetting="Polite"
                          Spacing="6">
                <TextBlock HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           Text="No attachable .NET processes found" />
                <TextBlock Classes="secondary"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Text="Start a .NET application, then refresh the list." />
              </StackPanel>
            </Grid>

            <Button Grid.Row="4"
                    Classes="action primary-action"
                    HorizontalAlignment="Right"
                    Command="{Binding AttachSelectedProcessCommand}"
                    Content="Start profiling" />
          </Grid>
        </Border>

        <Border Padding="0,20,0,8"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0">
          <StackPanel Spacing="10">
            <TextBlock Classes="section-title" Text="Recent Sessions" />

            <StackPanel IsVisible="{Binding IsSessionHistoryLoading}"
                        AutomationProperties.Name="Loading recent sessions"
                        AutomationProperties.LiveSetting="Polite"
                        Spacing="8">
              <Border Classes="skeleton" Width="220" HorizontalAlignment="Left" />
              <Border Classes="skeleton" Width="340" HorizontalAlignment="Left" />
            </StackPanel>

            <Grid IsVisible="{Binding HasSessionHistoryError}">
              <views:ErrorDetailsView DataContext="{Binding SessionHistoryError}" />
            </Grid>

            <Border IsVisible="{Binding IsRecentSessionsEmpty}"
                    Padding="0,2,0,0">
              <TextBlock Classes="secondary"
                         FontSize="13"
                         Text="No recent sessions yet." />
            </Border>

            <ItemsControl IsVisible="{Binding HasRecentSessions}"
                          ItemsSource="{Binding RecentSessions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentSessionRowViewModel">
                  <Border Padding="0,10"
                          BorderBrush="{DynamicResource AppBorderBrush}"
                          BorderThickness="0,0,0,1"
                          ToolTip.Tip="{Binding PathDisplay}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <TextBlock FontWeight="SemiBold"
                                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                                     TextTrimming="CharacterEllipsis"
                                     Text="{Binding Title}" />
                          <TextBlock Grid.Column="1"
                                     Classes="secondary"
                                     FontSize="12"
                                     Text="{Binding TimestampDisplay}" />
                        </Grid>
                        <TextBlock Classes="secondary"
                                   FontSize="12"
                                   Text="{Binding Details}" />
                        <TextBlock Classes="secondary"
                                   FontSize="12"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding PathDisplay}" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Classes="action"
                              MinHeight="34"
                              Padding="14,6"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding AutomationName}"
                              Command="{Binding OpenCommand}"
                              Content="Open" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
    <Grid IsVisible="{Binding IsLiveSessionVisible}">
      <views:LiveSessionView DataContext="{Binding LiveSession}" />
    </Grid>
    <Grid IsVisible="{Binding IsSnapshotVisible}">
      <views:SnapshotView DataContext="{Binding Snapshot}" />
    </Grid>
    <Grid IsVisible="{Binding IsComparisonVisible}">
      <views:ComparisonView DataContext="{Binding Comparison}" />
    </Grid>
  </Grid>
</Window>
