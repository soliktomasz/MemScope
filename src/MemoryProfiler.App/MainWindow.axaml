<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MemoryProfiler.App.ViewModels"
        xmlns:views="using:MemoryProfiler.App.Views"
        x:Class="MemoryProfiler.App.MainWindow"
        x:DataType="vm:StartViewModel"
        x:CompileBindings="True"
        Title="Memory Profiler"
        Icon="/Assets/memscope.ico"
        Width="1180"
        Height="780"
        MinWidth="820"
        MinHeight="640"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.Styles>
    <Style Selector="Border.session-row">
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppControlCornerRadius}" />
    </Style>
    <Style Selector="Border.session-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppControlHoverBrush}" />
    </Style>
  </Window.Styles>

  <Grid>
  <Grid Margin="{DynamicResource AppPageMargin}"
        IsVisible="{Binding IsStartVisible}"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="16">
    <Border Grid.Row="0"
            Classes="surface"
            Padding="22,18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="28">
        <StackPanel Spacing="4">
          <TextBlock Classes="page-title" Text="Memory Profiler" />
          <TextBlock Classes="secondary"
                     FontSize="14"
                     Text="Inspect managed processes and memory snapshots." />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="8">
          <Button Classes="app-button primary"
                  Command="{Binding AttachToProcessCommand}"
                  Content="Attach to Process" />
          <Button Classes="app-button"
                  Command="{Binding OpenDumpCommand}"
                  Content="Open Dump" />
          <Button Classes="app-button"
                  Command="{Binding CompareSnapshotsCommand}"
                  Content="Compare Snapshots" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" IsVisible="{Binding HasDumpError}">
      <views:ErrorDetailsView DataContext="{Binding DumpError}" />
    </Grid>

    <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16">
        <Border IsVisible="{Binding IsProcessPickerVisible}"
                Classes="surface"
                Padding="20">
          <Grid RowDefinitions="Auto,Auto,Auto,300,Auto"
                RowSpacing="12">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Classes="section-title"
                           Text="Attach to a .NET process" />
                <TextBlock Classes="secondary"
                           FontSize="13"
                           Text="Select a running process to inspect." />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="app-button subtle"
                      Command="{Binding ProcessPicker.RefreshCommand}"
                      Content="Refresh" />
            </Grid>

            <ProgressBar Grid.Row="1"
                         Height="2"
                         Margin="0,1,0,0"
                         AutomationProperties.Name="Discovering .NET processes"
                         AutomationProperties.LiveSetting="Polite"
                         IsVisible="{Binding ProcessPicker.IsLoading}"
                         IsIndeterminate="True" />

            <Grid Grid.Row="2" IsVisible="{Binding ProcessPicker.HasError}">
              <views:ErrorDetailsView DataContext="{Binding ProcessPicker.Error}" />
            </Grid>

            <Grid Grid.Row="3">
              <DataGrid IsVisible="{Binding ProcessPicker.HasProcesses}"
                        AutoGenerateColumns="False"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="True"
                        IsReadOnly="True"
                        GridLinesVisibility="Horizontal"
                        AutomationProperties.Name="Attachable .NET processes"
                        ItemsSource="{Binding ProcessPicker.Processes}"
                        SelectedItem="{Binding ProcessPicker.SelectedProcess, Mode=TwoWay}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="PID"
                                      Width="120"
                                      SortMemberPath="ProcessId"
                                      Binding="{Binding ProcessId}" />
                  <DataGridTextColumn Header="Process"
                                      Width="*"
                                      SortMemberPath="Name"
                                      Binding="{Binding Name}" />
                  <DataGridTextColumn Header="Runtime"
                                      Width="190"
                                      SortMemberPath="RuntimeDisplay"
                                      Binding="{Binding RuntimeDisplay}" />
                </DataGrid.Columns>
              </DataGrid>

              <StackPanel IsVisible="{Binding ProcessPicker.ShowLoadingPlaceholders}"
                          Spacing="18"
                          Margin="10,22">
                <Grid ColumnDefinitions="90,*,150" ColumnSpacing="28">
                  <Border Grid.Column="0" Classes="skeleton" />
                  <Border Grid.Column="1" Classes="skeleton" />
                  <Border Grid.Column="2" Classes="skeleton" />
                </Grid>
                <Grid ColumnDefinitions="90,*,150" ColumnSpacing="28">
                  <Border Grid.Column="0" Classes="skeleton" />
                  <Border Grid.Column="1" Classes="skeleton" />
                  <Border Grid.Column="2" Classes="skeleton" />
                </Grid>
                <Grid ColumnDefinitions="90,*,150" ColumnSpacing="28">
                  <Border Grid.Column="0" Classes="skeleton" />
                  <Border Grid.Column="1" Classes="skeleton" />
                  <Border Grid.Column="2" Classes="skeleton" />
                </Grid>
              </StackPanel>

              <Border IsVisible="{Binding ProcessPicker.IsEmpty}"
                      Classes="empty-state"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="No attachable .NET processes found"
                      AutomationProperties.LiveSetting="Polite">
                <StackPanel Spacing="6">
                  <TextBlock HorizontalAlignment="Center"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                             Text="No attachable .NET processes found" />
                  <TextBlock Classes="secondary"
                             HorizontalAlignment="Center"
                             Text="Start a .NET application, then refresh the list." />
                </StackPanel>
              </Border>
            </Grid>

            <Button Grid.Row="4"
                    Classes="app-button primary"
                    HorizontalAlignment="Right"
                    Command="{Binding AttachSelectedProcessCommand}"
                    Content="Start profiling" />
          </Grid>
        </Border>

        <Border Classes="subtle-surface"
                Padding="20,16">
          <StackPanel Spacing="12">
            <TextBlock Classes="section-title" Text="Recent Sessions" />

            <StackPanel IsVisible="{Binding IsSessionHistoryLoading}"
                        AutomationProperties.Name="Loading recent sessions"
                        AutomationProperties.LiveSetting="Polite"
                        Spacing="8">
              <Border Classes="skeleton" Width="220" HorizontalAlignment="Left" />
              <Border Classes="skeleton" Width="340" HorizontalAlignment="Left" />
            </StackPanel>

            <Grid IsVisible="{Binding HasSessionHistoryError}">
              <views:ErrorDetailsView DataContext="{Binding SessionHistoryError}" />
            </Grid>

            <Border IsVisible="{Binding IsRecentSessionsEmpty}"
                    Padding="0,2,0,0">
              <TextBlock Classes="secondary"
                         FontSize="13"
                         Text="No recent sessions yet." />
            </Border>

            <ItemsControl IsVisible="{Binding HasRecentSessions}"
                          ItemsSource="{Binding RecentSessions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentSessionRowViewModel">
                  <Border Classes="session-row"
                          BorderBrush="{DynamicResource AppBorderBrush}"
                          BorderThickness="0,0,0,1"
                          ToolTip.Tip="{Binding PathDisplay}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <TextBlock FontWeight="SemiBold"
                                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                                     TextTrimming="CharacterEllipsis"
                                     Text="{Binding Title}" />
                          <TextBlock Grid.Column="1"
                                     Classes="secondary"
                                     FontSize="12"
                                     Text="{Binding TimestampDisplay}" />
                        </Grid>
                        <TextBlock Classes="secondary"
                                   FontSize="12"
                                   Text="{Binding Details}" />
                        <TextBlock Classes="secondary"
                                   FontSize="12"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding PathDisplay}" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Classes="app-button subtle"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding AutomationName}"
                              Command="{Binding OpenCommand}"
                              Content="Open" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
    <Grid IsVisible="{Binding IsLiveSessionVisible}">
      <views:LiveSessionView DataContext="{Binding LiveSession}" />
    </Grid>
    <Grid IsVisible="{Binding IsSnapshotVisible}">
      <views:SnapshotView DataContext="{Binding Snapshot}" />
    </Grid>
    <Grid IsVisible="{Binding IsComparisonVisible}">
      <views:ComparisonView DataContext="{Binding Comparison}" />
    </Grid>
  </Grid>
</Window>
